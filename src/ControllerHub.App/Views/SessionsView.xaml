<UserControl x:Class="ControllerHub.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <!-- Bildirim / Geri Bildirim Banner'ı -->
            <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusFeedback}" FontWeight="Medium" Foreground="#067647" FontSize="13"/>
            </Border>

            <!-- Başlık ve Filtreler -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Oturum Geçmişi" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Kontrolcünün bilgisayara bağlandığı tüm oturumların kronolojik kaydı." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Kontrolcü Filtresi -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Görüntülenen Kontrolcü:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource FluentComboBoxStyle}"
                                  ItemsSource="{Binding ControllerFilterOptions}"
                                  SelectedItem="{Binding SelectedControllerFilter}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="240" Height="38" Padding="10,6"
                                  FontSize="13" FontWeight="Medium"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <Button Content="💾  CSV Dışa Aktar" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding ExportCsvCommand}" Height="38" Margin="0,18,10,0"/>

                    <Button Content="🗑️  Geçmişi Temizle" Style="{StaticResource DangerButtonStyle}" 
                            Command="{Binding ClearSessionsCommand}" Height="38" Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Filtre Sekmeleri (FR-06) -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="Tümü" IsChecked="True" Style="{StaticResource NavButtonStyle}" Margin="0,0,8,0"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Tümü"/>
                        <RadioButton Content="Bugün" Style="{StaticResource NavButtonStyle}" Margin="0,0,8,0"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Bugün"/>
                        <RadioButton Content="Bu Hafta" Style="{StaticResource NavButtonStyle}" Margin="0,0,8,0"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Bu Hafta"/>
                        <RadioButton Content="Bu Ay" Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Bu Ay"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TotalRecordedSessionsText}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- BOŞ DURUM: Filtrede Hiç Oturum Yoksa -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="32" Margin="0,0,0,24"
                    Visibility="{Binding IsEmptySessions, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Seçilen Filtrede Kayıtlı Oturum Bulunmuyor" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Kontrolcünüz bağlandığında oturum başlangıç ve bitiş kayıtları otomatik olarak buraya eklenecektir." 
                               FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Oturum Listesi Tablosu (Gerçek SQLite Kayıtları) -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16"
                    Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                          BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#FAFAFC"
                          HorizontalGridLinesBrush="{StaticResource BrushBorderLight}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLight}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="130"/>
                        <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartTime}" Width="100"/>
                        <DataGridTextColumn Header="Bitiş" Binding="{Binding EndTime}" Width="110"/>
                        <DataGridTextColumn Header="Bağlantı Süresi" Binding="{Binding Duration}" Width="120"/>
                        <DataGridTextColumn Header="Bitiş Sebebi" Binding="{Binding EndReason}" Width="170"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*"/>
                        <DataGridTemplateColumn Header="İşlem" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" ToolTip="Bu oturumu sil"
                                            Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13" Padding="4,2">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
