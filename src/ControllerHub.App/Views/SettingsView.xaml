<UserControl x:Class="ControllerHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ayarlar" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Uygulama tercihleri, sistem tepsisi ve veritabanı yönetimi." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Geri Bildirim Banner'ı -->
            <Border Background="#EBFBF3" BorderBrush="#B6ECCB" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeedbackVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FeedbackMessage}" FontWeight="Medium" Foreground="#067647" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissFeedbackCommand}" 
                            Background="Transparent" BorderThickness="0" Foreground="#067647" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Padding="6,2" Margin="10,0,0,0" ToolTip="Kapat"/>
                </Grid>
            </Border>

            <!-- 1. Sistem ve Bildirim Ayarları -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Sistem Entegrasyonu" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Windows açılışında otomatik başlat" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Kontrolcünüz bağlandığında oturumun kaçırılmaması için Gamepad Center arka planda açılır." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Kapatıldığında sistem tepsisine (Tray) küçült" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Pencereyi kapattığınızda uygulama kapanmaz; saatin yanındaki tepside oturumu saymaya devam eder." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,14" Cursor="Hand">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Bağlantı bildirimlerini göster" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Kontrolcünüz bağlandığında veya bağlantısı kesildiğinde Windows masaüstü bildirimi gösterir." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,14"/>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Masaüstü kısayolu oluştur" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Uygulamaya masaüstünden tek tıkla doğrudan erişmek için masaüstünüze kısayol simgesi ekler." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🖥️  Kısayol Oluştur" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding CreateDesktopShortcutCommand}" Padding="12,7" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Kontrolcülerim ve Takma Adlar (Çoklu Kol & Kişiselleştirme) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Kontrolcülerim ve Takma Adlar" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="Bilgisayarınıza bağlanan kontrolcülere özel isimler vererek Dashboard ve geçmişte kolayca ayırt edin." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14"/>

                    <!-- Boş Durum Bilgisi -->
                    <TextBlock Text="Henüz kayıtlı bir kontrolcü profili bulunmuyor. Bir oyun kolu bağlandığında profili otomatik olarak burada listelenecektir."
                               FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" Margin="0,4,0,10" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasKnownControllers}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding KnownControllers}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasKnownControllers}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBackgroundPage}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" Background="#F0F4FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Image Source="../Assets/logo_badge.png" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DefaultName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DeviceKey}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Width="150" MaxLength="50" Padding="8,6" FontSize="12.5" 
                                                     Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderMedium}" BorderThickness="1"
                                                     ToolTip="Örn: Siyah Kol, Logitech F310"/>
                                            <Button Content="💾 Kaydet" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" Padding="10,6" Command="{Binding SaveCommand}"/>
                                            <Button Content="🗑️ Kaldır" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" Padding="10,6" Command="{Binding DeleteProfileCommand}" ToolTip="Bu kontrolcü profilini ve geçmiş kayıtlarını siler"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Veritabanı ve Yerel Saklama -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Veri Depolama ve Gizlilik" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                    <TextBlock Text="Yerel Veritabanı Konumu (SQLite):" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                    <Grid Margin="0,6,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DatabasePath}" IsReadOnly="True" Padding="10,8" FontSize="12" Background="{StaticResource BrushBackgroundPage}" BorderBrush="{StaticResource BrushBorderLight}"/>
                        <Button Grid.Column="2" Content="Klasörü Aç" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDatabaseFolderCommand}"/>
                    </Grid>

                    <TextBlock Text="* Tüm oturum ve pil kayıtlarınız yalnızca bu bilgisayarda saklanır, internete hiçbir veri aktarılmaz." FontSize="11.5" Foreground="{StaticResource BrushSuccess}"/>
                </StackPanel>
            </Border>

            <!-- 3. Hakkında -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Hakkında" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Uygulama Sürümü" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding AppVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Hedef Donanım" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding TrackedControllerName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,8"/>

                    <Grid>
                        <TextBlock Text="Algılama Motoru" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="Windows PnP + WinRT BLE GATT (Hibrit)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
