<UserControl x:Class="ControllerHub.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <!-- Başlık ve Kontrolcü Bilgisi / Filtresi -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Genel Bakış" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Oyun kolunuzun gerçek zamanlı bağlantı süreleri ve pil kullanım özeti." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Kontrolcü Bazında Filtreleme Açılır Kutusu (Çoklu Kol Analizi) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Görüntülenen Kontrolcü:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                    <ComboBox Style="{StaticResource FluentComboBoxStyle}"
                              ItemsSource="{Binding ControllerFilterOptions}"
                              SelectedItem="{Binding SelectedControllerFilter}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="260" Height="40" Padding="12,8"
                              FontSize="13" FontWeight="Medium"
                              Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Geri Bildirim Banner'ı (Örn: CSV Dışa Aktarıldı) -->
            <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusFeedback}" FontWeight="Medium" Foreground="#067647" FontSize="13"/>
            </Border>

            <!-- Olası Pil Değişimi Bildirimi (Aşama 7) -->
            <Border Background="#F0F9FF" BorderBrush="#B2DDFF" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasBatteryProposal, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔋" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding BatteryProposalText}" FontWeight="Medium" Foreground="#175CD3" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Pil Yönetimi sekmesinden inceleyin ➔" FontSize="11.5" Foreground="#2E90FA" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- 4 GERÇEK KPI METRİK KARTI (SQLite & Canlı Donanım Verisi) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Kart 1: Toplam Süre -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Bağlantı Süresi" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TotalConnectionTime}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,4" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                        <TextBlock Text="Kalıcı SQLite verisi" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Kart 2: Bugünkü Süre -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Bugünkü Bağlantı Süresi" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TodayConnectionTime}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,8,0,4" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                        <TextBlock Text="Bugün 00:00'dan itibaren" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Kart 3: Pil Seviyesi -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Mevcut Pil Seviyesi" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BatteryLevelText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,8,0,4" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                        <TextBlock Text="{Binding BatterySourceText}" FontSize="11" Foreground="{StaticResource BrushSuccess}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Kart 4: Toplam Oturum -->
                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Oturum" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TotalSessionsCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,4" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                        <TextBlock Text="Tamamlanan bağlantılar" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BOŞ DURUM (EMPTY STATE) — Henüz hiç oturum kaydedilmemişse -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="32" Margin="0,0,0,24"
                    Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" Background="#F0F4FF" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image Source="../Assets/logo_badge.png" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Henüz Kaydedilmiş Oturum Bulunmuyor" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Oyun kolunuz bağlandığında oturumunuz otomatik başlatılacak ve kullanım süreniz burada canlı sayılacaktır." 
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,6,0,14" MaxWidth="520" TextWrapping="Wrap"/>
                    <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center">
                        <TextBlock Text="💡 İpucu: Kontrolcünüzün açma tuşuna veya logosuna basarak hemen açabilirsiniz." FontSize="12" Foreground="#067647" FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ORTA KISIM: Gerçek Grafik ve Hızlı İşlemler (Oturumlar varsa) -->
            <Grid Margin="0,0,0,24" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Son 7 Günlük Kullanım Grafiği (Çizgi Grafik - Gerçek SQLite Verisinden) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Son 7 Günlük Gerçek Bağlantı Süresi" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Saat cinsinden" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Viewbox Stretch="Uniform" Height="140" HorizontalAlignment="Center">
                            <Canvas Width="490" Height="130" ClipToBounds="False">
                                <!-- Arka Plan Kılavuz Çizgileri -->
                                <Line X1="20" Y1="92" X2="470" Y2="92" Stroke="{StaticResource BrushBorderLight}" StrokeThickness="1"/>
                                <Line X1="20" Y1="60" X2="470" Y2="60" Stroke="{StaticResource BrushBorderLight}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.6"/>
                                <Line X1="20" Y1="28" X2="470" Y2="28" Stroke="{StaticResource BrushBorderLight}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.6"/>

                                <!-- Çizgi Altı Alan Dolgusu (Gradient) -->
                                <Polygon Points="{Binding ActivityAreaPoints}">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#402563EB" Offset="0"/>
                                            <GradientStop Color="#022563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>

                                <!-- Ana Aktivite Çizgisi -->
                                <Polyline Points="{Binding ActivityLinePoints}"
                                          Stroke="{StaticResource BrushAccent}"
                                          StrokeThickness="3"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>

                                <!-- 7 Günlük Veri Noktaları (Süreler, Çizgi Noktaları ve Gün Başlıkları) -->
                                <ItemsControl ItemsSource="{Binding WeeklyActivity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PointX}"/>
                                            <Setter Property="Canvas.Top" Value="0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="60" Height="130" Margin="-30,0,0,0">
                                                <!-- Süre Değeri Etiketi -->
                                                <TextBlock Canvas.Top="{Binding LabelTop}" Canvas.Left="0" Width="60"
                                                           Text="{Binding DisplayText}" TextAlignment="Center"
                                                           FontSize="10.5" FontWeight="{Binding LabelFontWeight}"
                                                           Foreground="{Binding LabelBrushHex}"/>

                                                <!-- Çizgi Üzerindeki Dairesel Nokta -->
                                                <Ellipse Canvas.Top="{Binding DotTop}" Canvas.Left="25.5" Width="9" Height="9"
                                                         Fill="White" Stroke="{StaticResource BrushAccent}" StrokeThickness="2.5"/>

                                                <!-- Gün Adı (Bugün ise Vurgulu) -->
                                                <TextBlock Canvas.Top="104" Canvas.Left="0" Width="60"
                                                           Text="{Binding DayName}" TextAlignment="Center"
                                                           FontSize="12" FontWeight="{Binding DayFontWeight}"
                                                           Foreground="{Binding DayBrushHex}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- Sağ: Hızlı İşlemler & Cihaz Durum Özeti -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Hızlı İşlemler" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16"/>

                        <Button Content="{Binding BatteryActionButtonText}" Command="{Binding NavigateBatteryCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button Content="📋  Tüm Oturumları Gör" Command="{Binding ViewAllSessionsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button Content="💾  CSV Dışa Aktar" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>

                        <Border Background="{StaticResource BrushBackgroundPage}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Bağlantı Algılama Motoru" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Windows PnP + BLE GATT (Hibrit)" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,2"/>
                                <TextBlock Text="Depolama: SQLite WAL Modu" FontSize="11" Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SON OTURUMLAR TABLOSU (Gerçek SQLite Verisi) -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Son Oturumlar" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="En son gerçekleşen bağlantılar" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding RecentSessions}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                              BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#FAFAFC"
                              HorizontalGridLinesBrush="{StaticResource BrushBorderLight}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLight}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                <Setter Property="Padding" Value="6,4"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="Zaman Aralığı" Binding="{Binding TimeRange}" Width="160"/>
                            <DataGridTextColumn Header="Bağlantı Süresi" Binding="{Binding Duration}" Width="130"/>
                            <DataGridTextColumn Header="Kapanış Nedeni" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
