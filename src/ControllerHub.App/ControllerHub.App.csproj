<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ControllerHub.Core\ControllerHub.Core.csproj" />
    <ProjectReference Include="..\ControllerHub.Infrastructure\ControllerHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ControllerHub</AssemblyName>

    <!-- Sürüm ve Uygulama Meta Verileri (Aşama 9) -->
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Controller Hub</Product>
    <Description>Windows 11 Xbox Controller Bluetooth Session &amp; Battery Monitor</Description>
    <Authors>ControllerHub</Authors>
    <Company>ControllerHub</Company>
    <Copyright>Copyright © 2026 ControllerHub</Copyright>
  </PropertyGroup>

</Project>
