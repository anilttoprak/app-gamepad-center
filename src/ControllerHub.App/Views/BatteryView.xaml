<UserControl x:Class="ControllerHub.App.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32">

            <!-- Bildirim / Geri Bildirim Banner'ı -->
            <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusFeedback}" FontWeight="Medium" Foreground="#067647" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- KULLANICI ONAYI BEKLEYEN PİL DEĞİŞİM ÖNERİSİ (Aşama 7 - Otomasyon & Güvenlik) -->
            <Border Background="#F0F9FF" BorderBrush="#B2DDFF" BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,0,0,18"
                    Visibility="{Binding HasPendingProposal, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔋" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Olası Pil Değişimi Algılandı" FontSize="14" FontWeight="Bold" Foreground="#175CD3"/>
                        <TextBlock Text="{Binding PendingProposalText}" FontSize="12.5" Foreground="#1849A9" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding ProposalDetails}" FontSize="12" FontWeight="SemiBold" Foreground="#2E90FA" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✓  Evet, Kaydet" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding AcceptProposalCommand}" Margin="0,0,8,0" Padding="12,7"/>
                        <Button Content="✕  Yoksay" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding DismissProposalCommand}" Padding="10,7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Başlık ve Filtreler (Responsive WrapPanel) -->
            <WrapPanel Margin="0,0,0,20" Orientation="Horizontal">
                <StackPanel Margin="0,0,24,12" VerticalAlignment="Center">
                    <TextBlock Text="Pil Yönetimi" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Bluetooth donanımsal pil durumu, telemetri hassasiyeti ve pil seti değişim kayıtları." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <!-- Kontrolcü Filtresi -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,6">
                        <TextBlock Text="Görüntülenen Kontrolcü:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource FluentComboBoxStyle}"
                                  ItemsSource="{Binding ControllerFilterOptions}"
                                  SelectedItem="{Binding SelectedControllerFilter}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="220" Height="38" Padding="10,6"
                                  FontSize="13" FontWeight="Medium"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <Button Content="💾  CSV Dışa Aktar" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding ExportCsvCommand}" Height="38" Margin="0,18,0,6"/>
                </WrapPanel>
            </WrapPanel>

            <!-- Üst Blok: Mevcut Durum ve Pil Değişimi Formu (Responsive 2 Sütun) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Canlı Pil Durumu -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Mevcut Pil Seviyesi" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding CurrentPercentage}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,8,0,4" Typography.NumeralAlignment="Tabular"/>
                        
                        <!-- Dinamik Pil Seviye Gösterge Çubuğu -->
                        <Border Height="10" Background="#E2F5EA" CornerRadius="5" Margin="0,4,0,14">
                            <Border Width="{Binding BatteryLevelBarWidth}" HorizontalAlignment="Left" Background="{StaticResource BrushSuccess}" CornerRadius="5"/>
                        </Border>

                        <!-- Telemetri Doğruluk & Kaynak Rozetleri -->
                        <StackPanel Margin="0,0,0,10">
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Veri Kaynağı:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#F2F4F7" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfidenceDescription}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding SourceDescription}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Son Ölçüm Bilgisi:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,12" TextWrapping="Wrap"/>

                        <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,12"/>

                        <!-- Manuel Seviye Girme Alanı (FR-07) -->
                        <TextBlock Text="Manuel Pil Seviyesi Güncelle (%):" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ManualPercentageInput, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12.5"/>
                            <Button Grid.Column="2" Content="Güncelle" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveManualPercentageCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sağ: Pil Değiştirdim Formu (FR-07) -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding BatteryFormTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BatteryFormSubtitle}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.8*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Başlangıç (%)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewBatteryPercentage, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="{StaticResource BrushBorderMedium}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pil Modeli / Not (Opsiyonel)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding BatteryNote, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="{StaticResource BrushBorderMedium}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{Binding BatterySaveButtonText}" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding SaveBatteryChangeCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pil Performans & Döngü Analizi Kartları -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Mevcut Pil Seti Oynama Süresi" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveBatteryUsageText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Son pil değişiminden bu yana" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Ortalama Pil Seti Ömrü" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding AverageBatteryDurationText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Tamamlanan setlerin ortalaması" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="En Uzun Dayanan Pil Seti" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BestBatterySetText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Tek setteki en yüksek oynama süresi" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BOŞ DURUM: Hiç Pil Değişimi Kaydedilmemişse -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="28" Margin="0,0,0,24"
                    Visibility="{Binding IsEmptyChanges, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Henüz Kaydedilmiş Pil Değişimi Bulunmuyor" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Yeni bir pil seti taktığınızda yukarıdaki formdan 'Pil Değişimini Kaydet' butonuna basarak ilk kaydınızı oluşturabilirsiniz." 
                               FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,4,0,0" MaxWidth="500"/>
                </StackPanel>
            </Border>

            <!-- Alt Blok: Gerçek Pil Değişim Geçmişi Tablosu -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Pil Değişim Geçmişi" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Kalıcı SQLite kayıtları" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding ChangeHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                              BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#FAFAFC"
                              HorizontalGridLinesBrush="{StaticResource BrushBorderLight}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLight}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                <Setter Property="Padding" Value="6,4"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45"/>
                            <DataGridTextColumn Header="Değişim Tarihi" Binding="{Binding Date}" Width="135"/>
                            <DataGridTextColumn Header="Eski" Binding="{Binding PreviousLevelText}" Width="65"/>
                            <DataGridTextColumn Header="Yeni" Binding="{Binding NewLevelText}" Width="65"/>
                            <DataGridTextColumn Header="Pil Modeli / Not" Binding="{Binding Note}" Width="*"/>
                            <DataGridTextColumn Header="Performans (Süre &amp; Oturum)" Binding="{Binding PerformanceText}" Width="185"/>
                            <DataGridTextColumn Header="Kayıt Türü" Binding="{Binding Source}" Width="100"/>
                            <DataGridTemplateColumn Header="İşlem" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ Sil" Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,2" FontSize="11" Foreground="#DC4C64" BorderBrush="#FECDD3" Background="#FFF5F5"
                                                Command="{Binding DataContext.DeleteBatteryChangeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="Bu pil kaydını geçmişten sil"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
