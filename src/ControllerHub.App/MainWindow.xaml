<Window x:Class="ControllerHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ControllerHub.App.ViewModels"
        xmlns:views="clr-namespace:ControllerHub.App.Views"
        mc:Ignorable="d"
        Title="Controller Hub — Xbox Kontrol Merkezi" 
        Height="780" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundPage}">

    <Window.Resources>
        <!-- DataTemplates: ViewModel -> View Eşleşmeleri -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatteryViewModel}">
            <views:BatteryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL NAVİGASYON PANELİ (Fluent White Sidebar) -->
        <Border Grid.Column="0" Background="{StaticResource BrushBackgroundSidebar}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Logo & Uygulama Başlığı -->
                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Modern Gamepad İkon Rozeti -->
                        <Border Grid.Column="0" Width="36" Height="36" Background="{StaticResource BrushAccent}" CornerRadius="9" Margin="0,0,12,0">
                            <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Controller Hub" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Xbox Kontrol Merkezi" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 2. Menü Butonları -->
                <StackPanel Grid.Row="2">
                    <RadioButton Content="📊  Genel Bakış" Style="{StaticResource NavButtonStyle}" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>

                    <RadioButton Content="📋  Oturum Geçmişi" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Sessions"/>

                    <RadioButton Content="📈  Analizler" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Analytics"/>

                    <RadioButton Content="🔋  Pil Yönetimi" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Battery"/>

                    <RadioButton Content="⚙️  Ayarlar" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <!-- 3. Alt Cihaz Durum Kartı -->
                <Border Grid.Row="3" Background="{StaticResource BrushBackgroundPage}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveControllerName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Kırmızı/Gri Durum Noktası -->
                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionStatusBadge}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SAĞ ANA İÇERİK ALANI -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>

    </Grid>
</Window>
