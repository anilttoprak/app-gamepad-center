<UserControl x:Class="ControllerHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ayarlar" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Uygulama tercihleri, sistem tepsisi ve veritabanı yönetimi." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 1. Sistem ve Bildirim Ayarları -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Sistem Entegrasyonu" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Windows açılışında otomatik başlat" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Kontrolcünüz bağlandığında oturumun kaçırılmaması için Controller Hub arka planda açılır." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Kapatıldığında sistem tepsisine (Tray) küçült" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Pencereyi kapattığınızda uygulama kapanmaz; saatin yanındaki tepside oturumu saymaya devam eder." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding NotificationsEnabled}" Cursor="Hand">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Bağlantı bildirimlerini göster" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Xbox kontrolcünüz bağlandığında veya bağlantısı kesildiğinde Windows masaüstü bildirimi gösterir." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- 2. Kontrolcülerim ve Takma Adlar (Çoklu Kol & Kişiselleştirme) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Kontrolcülerim ve Takma Adlar" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="Bilgisayarınıza bağlanan kontrolcülere özel isimler vererek Dashboard ve geçmişte kolayca ayırt edin." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding KnownControllers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBackgroundPage}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" Background="{StaticResource BrushAccent}" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DefaultName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding DeviceKey}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="8,6" FontSize="12.5" 
                                                     Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderMedium}" BorderThickness="1"
                                                     ToolTip="Örn: Siyah Kol, Logitech F310"/>
                                            <Button Content="💾 Kaydet" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="10,6" Command="{Binding SaveCommand}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Veritabanı ve Yerel Saklama -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Veri Depolama ve Gizlilik" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                    <TextBlock Text="Yerel Veritabanı Konumu (SQLite):" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                    <Grid Margin="0,6,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DatabasePath}" IsReadOnly="True" Padding="10,8" FontSize="12" Background="{StaticResource BrushBackgroundPage}" BorderBrush="{StaticResource BrushBorderLight}"/>
                        <Button Grid.Column="2" Content="Klasörü Aç" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDatabaseFolderCommand}"/>
                    </Grid>

                    <TextBlock Text="* Tüm oturum ve pil kayıtlarınız yalnızca bu bilgisayarda saklanır, internete hiçbir veri aktarılmaz." FontSize="11.5" Foreground="{StaticResource BrushSuccess}"/>
                </StackPanel>
            </Border>

            <!-- 3. Hakkında -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Hakkında" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Uygulama Sürümü" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding AppVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Hedef Donanım" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding TrackedControllerName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Separator Background="{StaticResource BrushBorderLight}" Margin="0,0,0,8"/>

                    <Grid>
                        <TextBlock Text="Algılama Motoru" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="Windows PnP + WinRT BLE GATT (Hibrit)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
