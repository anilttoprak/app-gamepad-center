<Window x:Class="ControllerHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ControllerHub.App.ViewModels"
        xmlns:views="clr-namespace:ControllerHub.App.Views"
        mc:Ignorable="d"
        Title="Gamepad Center — Evrensel Kontrol Merkezi" 
        Height="780" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundPage}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- DataTemplates: ViewModel -> View Eşleşmeleri -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatteryViewModel}">
            <views:BatteryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL NAVİGASYON PANELİ (Fluent White Sidebar) -->
        <Border Grid.Column="0" Background="{StaticResource BrushBackgroundSidebar}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Logo & Uygulama Başlığı -->
                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Modern Gamepad İkon Rozeti -->
                        <Border Grid.Column="0" Width="36" Height="36" Background="{StaticResource BrushAccent}" CornerRadius="9" Margin="0,0,12,0">
                            <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Gamepad Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Evrensel Kontrol Merkezi" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 2. Menü Butonları -->
                <StackPanel Grid.Row="2">
                    <RadioButton Content="📊  Genel Bakış" Style="{StaticResource NavButtonStyle}" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>

                    <RadioButton Content="📋  Oturum Geçmişi" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Sessions"/>

                    <RadioButton Content="📈  Analizler" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Analytics"/>

                    <RadioButton Content="🔋  Pil Yönetimi" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Battery"/>

                    <RadioButton Content="⚙️  Ayarlar" Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <!-- 3. Alt Cihaz Durum Paneli (Bağlı Kontrolcüler ve Tanılama) -->
                <Border Grid.Row="3" Background="{StaticResource BrushBackgroundPage}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <TextBlock Text="BAĞLI KONTROLCÜLER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="2,0,0,6"/>

                        <!-- Eğer hiç kol bağlı değilse gösterilecek durum -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding HasNoConnectedControllers, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#98A2B3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Bağlı Kontrolcü Yok" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Bağlı kontrolcüler listesi -->
                        <ItemsControl ItemsSource="{Binding ConnectedControllers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- İkon -->
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <!-- İsim ve Detay -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Ellipse Width="6" Height="6" Fill="#12B76A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding ConnectionBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding BatteryText}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Takma Ad Düzenle Butonu -->
                                            <Button Grid.Column="2" Content="✏️" FontSize="11" Padding="4,2" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                    ToolTip="Takma Adı Değiştir"
                                                    Command="{Binding DataContext.RenameControllerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Debug / Tanılama Paneli -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                            <TextBlock Text="{Binding HardwareDiagnosticsText}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SAĞ ANA İÇERİK ALANI -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>

    </Grid>
</Window>
