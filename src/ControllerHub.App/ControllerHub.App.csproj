<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ControllerHub.Core\ControllerHub.Core.csproj" />
    <ProjectReference Include="..\ControllerHub.Infrastructure\ControllerHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GamepadCenter</AssemblyName>

    <!-- Sürüm ve Uygulama Meta Verileri (Aşama 9) -->
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>Gamepad Center</Product>
    <AssemblyTitle>Gamepad Center</AssemblyTitle>
    <Description>Gamepad Center — Evrensel Oyun Kolu Oturum ve Pil Yöneticisi</Description>
    <Authors>GamepadCenter</Authors>
    <Company>GamepadCenter</Company>
    <Copyright>Copyright © 2026 Gamepad Center</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png" />
    <Resource Include="Assets\logo_badge.png" />
  </ItemGroup>

</Project>
